{
  "name": "dressup-strategy",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "cn-search"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint eslint.config.mjs playwright.config.mjs src/domain src/legacy \"scripts/*.mjs\" tests cn-search/scripts cn-search/src tool.js main.mjs model.mjs ui.mjs nikki.mjs onekeystrategy.mjs onekeystrategy_lan.mjs clock.mjs sharewardrobe.mjs biguse.mjs biguse_model.mjs biguse_ui.mjs biguse_nikki.mjs material_model.mjs material.mjs wardrobechk.mjs --max-warnings 0",
    "typecheck": "node scripts/typecheck-baseline.mjs",
    "typecheck:raw": "tsc -p tsconfig.json --pretty false",
    "typecheck:update": "node scripts/typecheck-baseline.mjs --update",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:levels": "node scripts/validate-levels.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:data && npm run validate:levels",
    "build:cn-index": "npm run build:cn-index --workspace cn-search",
    "start:main": "node scripts/launch-main.mjs",
    "data:stage:wardrobe": "node scripts/stage-wardrobe-import.mjs",
    "data:preview:wardrobe": "node scripts/review-wardrobe-staging.mjs",
    "data:apply:wardrobe": "node scripts/review-wardrobe-staging.mjs --apply",
    "data:check:derived": "node scripts/derived-rebuild.mjs --check",
    "data:rebuild:derived": "node scripts/derived-rebuild.mjs",
    "data:stage:levels": "node scripts/stage-level-import.mjs",
    "data:preview:levels": "node scripts/review-level-staging.mjs",
    "data:apply:levels": "node scripts/review-level-staging.mjs --apply",
    "data:update": "node scripts/data-update.mjs",
    "data:inspect:external": "node scripts/inspect-external-source.mjs",
    "data:session": "node scripts/update-session-cli.mjs",
    "data:session:wardrobe": "node scripts/update-wardrobe-cli.mjs",
    "data:session:levels": "node scripts/update-levels-cli.mjs",
    "data:session:completeness": "node scripts/update-completeness-cli.mjs",
    "data:session:diff": "node scripts/update-diff-preview-cli.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "10.0.0",
    "typescript": "7.0.2"
  }
}
